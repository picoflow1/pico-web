---
layout: layouts/marketing.njk
title: A TypeScript runtime for multi-turn AI assistants
description: PicoFlow is a TypeScript runtime for multi-turn AI assistants. Each conversation stage is a class, each transition is a return statement, and every session is a durable, revision-checked document.
---
<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div>
      <p class="eyebrow">TypeScript runtime · @picoflow/core</p>
      <h1 id="hero-title">Build multi&#8209;turn AI assistants, not session engines.</h1>
      <p class="hero__lede">Every assistant needs the same machinery: a tool loop, a durable cursor over conversation stages, session storage, and safe concurrent writes. PicoFlow ships that. You write the stages.</p>
      <div class="hero__actions">
        <a class="button button--gold" href="/docs/get-started/">Start building <span aria-hidden="true">→</span></a>
        <a class="button button--ghost" href="#evidence">See the LangGraph comparison</a>
      </div>
      <p class="hero__caption"><strong>The same hotel-booking assistant:</strong> 472 lines on PicoFlow, 1,397 lines built directly on LangGraph. <a href="#evidence">Both implementations are in the demo repo.</a></p>
    </div>
    <div class="code-card hero__code" aria-label="A PicoFlow step, in TypeScript">
      <div class="code-card__bar"><span>hotel-flow/explore-step.ts</span><span>TypeScript</span></div>
      {% set heroCode %}
export class ExploreStep extends Step {
  getPrompt() {
    return `${HotelPrompt.Role}
      Collect dates, then call capture_choices.`;
  }

  defineTool(): ToolType[] {
    return [{
      name: "capture_choices",
      description: "Capture hotel search criteria",
      schema: z.object({ json: z.string() }),
    }];
  }

  @Tool
  protected async capture_choices(
    args: { json: string },
  ): Promise<ToolResponseType> {
    const hotels = await Pricing.search(args.json);

    if (!hotels.length) {
      return stay("No match. Ask for wider criteria.");
    }
    return go(PresentStep).withState({ hotels });
  }
}
      {% endset %}
      <pre class="hljs"><code class="hljs language-typescript">{{ heroCode | highlightTs | safe }}</code></pre>
    </div>
  </div>
</section>

