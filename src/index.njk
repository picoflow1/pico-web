<section class="section section--soft" aria-labelledby="boundary-title">
  <div class="shell split-feature">
    <div>
      <p class="eyebrow">Where the business rule lives</p>
      <h2 class="section-heading" id="boundary-title">The model proposes. Your code decides.</h2>
      <p class="section-lede">A model can call a tool, but your handler validates the argument, writes state, and returns the next stage. Routing is a return value in a typed method — not an instruction buried in prompt prose that you cannot unit test.</p>
      <ul class="boundary-list">
        <li><code>stay()</code> keeps the current step active and hands corrective feedback back to the model.</li>
        <li><code>go(Step)</code> moves the durable cursor and optionally seeds the next step's state.</li>
        <li><code>direct()</code> answers the user immediately, with no second model call.</li>
      </ul>
      <div class="hero__actions"><a class="button button--ink" href="/docs/get-started/first-flow/">Build a first flow</a><a class="button button--light" href="/docs/guides/tools/">Read the tools guide</a></div>
    </div>
    <div class="code-card" aria-label="Registering a flow with PicoFlow">
      <div class="code-card__bar"><span>app.module.ts</span><span>TypeScript</span></div>
      {% set bootstrapCode %}
FlowEngine.create({
  flows: [HotelFlow, SupportFlow],
  providers: ModelProvider.createBuiltinAdapters({
    openai: { apiKey: process.env.OPENAI_API_KEY },
    anthropic: { apiKey: process.env.ANTHROPIC_API_KEY },
  }),
});

// One endpoint serves every flow.
const result = await engine.run({
  flowName: "HotelFlow",
  userMessage: "I need a room in Portland",
  sessionId,
});
      {% endset %}
      <pre class="hljs"><code class="hljs language-typescript">{{ bootstrapCode | highlightTs | safe }}</code></pre>
    </div>
  </div>
</section>

