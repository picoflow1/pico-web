<!doctype html>
<html lang="en">
<head>
  {% set ezgraphPageTitle = title | replace(' | EZGraph', '') %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0e13">
  <title>{{ ezgraphPageTitle }} | EZGraph</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/ezgraph/img/logo.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="EZGraph">
  <meta property="og:title" content="{{ ezgraphPageTitle }} | EZGraph">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/ezgraph/img/marketing-card.svg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="EZGraph — the application layer for guided LangGraph workflows">
  <meta name="twitter:card" content="summary_large_image">
  {% if ezgraphDocument or ezgraphDocs %}<link rel="stylesheet" href="/assets/css/ezgraph.css">{% endif %}
  <link rel="stylesheet" href="/assets/css/ezgraph-marketing.css">
  {% if ezgraphDocument or ezgraphDocs %}<link rel="stylesheet" href="/assets/css/ezgraph-docs.css">{% endif %}
</head>
<body class="ezgraph-site">
  <a class="eg-skip" href="#main">Skip to content</a>
  <header class="eg-header">
    <div class="eg-container eg-header-inner">
      <a class="eg-brand" href="/" aria-label="EZGraph home"><img src="/assets/ezgraph/img/logo.svg" alt="EZGraph" width="151" height="36"></a>
      <nav class="eg-nav" aria-label="EZGraph navigation">
        <a href="/ezgraph/why/"{% if page.url == '/ezgraph/why/' %} aria-current="page"{% endif %}>Why EZGraph</a>
        <a href="/ezgraph/workflows/"{% if page.url == '/ezgraph/workflows/' or page.url == '/ezgraph/quote-graph/' %} aria-current="{% if page.url == '/ezgraph/workflows/' %}page{% else %}true{% endif %}"{% endif %}>Workflows</a>
        <a href="/ezgraph/compare/langgraph/"{% if ezgraphCompare %} aria-current="{% if page.url == '/ezgraph/compare/langgraph/' %}page{% else %}true{% endif %}"{% endif %}>vs. LangGraph</a>
        <a href="/ezgraph/docs/developer-guide/"{% if ezgraphDocument or ezgraphDocs %} aria-current="{% if page.url == '/ezgraph/docs/developer-guide/' %}page{% else %}true{% endif %}"{% endif %}>Docs</a>
        <a href="/ezgraph/license/"{% if page.url == '/ezgraph/license/' %} aria-current="page"{% endif %}>Licence</a>
      </nav>
      <a class="eg-button eg-button-small" href="/ezgraph/tutorial/"{% if page.url == '/ezgraph/tutorial/' %} aria-current="page"{% endif %}>Get started <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  {% include "partials/ezgraph/landing/ticker.njk" %}
  <main id="main">{% if ezgraphLegal %}<div class="eg-container eg-legal">{% endif %}{{ content | safe }}{% if ezgraphLegal %}</div>{% endif %}</main>
  <footer class="eg-footer">
    <div class="eg-container eg-footer-top">
      <div><a class="eg-brand" href="/"><img src="/assets/ezgraph/img/logo.svg" alt="EZGraph" width="151" height="36"></a><p>A consistent application layer.<br>A real LangGraph underneath.</p><span class="eg-byline">Built by PicoFlow</span></div>
      <div><h2>Build</h2><a href="/ezgraph/tutorial/">First workflow</a><a href="/ezgraph/workflows/">Workflow examples</a><a href="/ezgraph/docs/developer-guide/">Developer guide</a><a href="https://www.npmjs.com/package/@picoflow/ezgraph">npm package ↗</a></div>
      <div><h2>Explore</h2><a href="/ezgraph/why/">Why EZGraph</a><a href="/ezgraph/compare/langgraph/">Compare the layers</a><a href="/ezgraph/quote-graph/">QuoteGraph walkthrough</a></div>
      <div>
        <h2>Connect</h2>
        <a href="/ezgraph/license/">Runtime license</a>
        <a href="mailto:{{ site.email }}">Contact &amp; Support</a>
        <a class="eg-footer-social" href="https://github.com/picoflowio/ezgraph-demo">
          <svg class="eg-footer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.67 1.24 3.32.95.1-.74.4-1.24.73-1.52-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18A10.9 10.9 0 0 1 12 6.32c.97 0 1.94.13 2.85.38 2.18-1.49 3.14-1.18 3.14-1.18.62 1.59.23 2.76.12 3.05.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.04.78 2.1 0 1.52-.01 2.75-.01 3.12 0 .3.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
          <span>GitHub demo</span>
        </a>
        <a class="eg-footer-social" href="{{ site.discord }}">
          <svg class="eg-footer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19.54 5.08A16.9 16.9 0 0 0 15.4 3.8l-.52 1.06a15.7 15.7 0 0 0-5.76 0L8.6 3.8a16.9 16.9 0 0 0-4.14 1.28C1.84 8.87 1.13 12.6 1.49 16.27a16.8 16.8 0 0 0 5.07 2.56l1.23-1.67c-.67-.25-1.3-.56-1.9-.92l.47-.36c3.67 1.7 7.65 1.7 11.28 0l.47.36c-.6.36-1.23.67-1.9.92l1.23 1.67a16.8 16.8 0 0 0 5.07-2.56c.42-4.25-.72-7.94-3.07-11.19ZM8.35 14.3c-1.1 0-2-.99-2-2.2s.88-2.2 2-2.2c1.13 0 2.02.99 2 2.2 0 1.21-.88 2.2-2 2.2Zm7.3 0c-1.1 0-2-.99-2-2.2s.88-2.2 2-2.2c1.13 0 2.02.99 2 2.2 0 1.21-.88 2.2-2 2.2Z"/></svg>
          <span>Discord community</span>
        </a>
        <a class="eg-footer-social" href="{{ site.linkedin }}">
          <svg class="eg-footer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.2 3.5a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4ZM3.3 9.4h3.8V21H3.3V9.4Zm6.1 0h3.6V11h.05c.5-.95 1.72-1.95 3.55-1.95 3.8 0 4.5 2.5 4.5 5.76V21h-3.8v-5.5c0-1.31-.02-3-1.83-3-1.84 0-2.12 1.43-2.12 2.9V21H9.4V9.4Z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
    <div class="eg-container eg-footer-bottom"><span>© {{ site.year }} picoflow LLC</span><span>Free production use under the <a href="/ezgraph/license/">commercial runtime license</a>. Model and hosting costs are yours.</span></div>
  </footer>
</body>
</html>
