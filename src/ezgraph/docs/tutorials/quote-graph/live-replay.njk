    <tr><td>14</td><td>What would it cost if both deductibles were $1000?</td><td>QuoteNode</td><td><code>adjust_quote</code> → rating → <code>direct(text)</code></td><td><strong>code</strong></td></tr>
    <tr><td>15</td><td>Accept my selected option, please.</td><td>QuoteNode → end</td><td><code>accept_quote</code> → <code>finish(text)</code></td><td><strong>code</strong></td></tr>
